# Postgres
POSTGRES_PASSWORD=lume
DATABASE_URL=postgres://lume:lume@localhost:5432/lume

# API
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth.js
AUTH_SECRET=replace-me-with-a-48-char-random-secret-string-min
AUTH_URL=http://localhost:3000

# Google OAuth — criar em console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filesystem
TMP_DIR=/tmp/lume

# Web -> backend (server-to-server, dentro da rede docker em prod = http://api:3001)
API_INTERNAL_URL=http://localhost:3001

# Anthropic
ANTHROPIC_API_KEY=
# Set true em dev pra usar mock LLM (zero gasto Anthropic)
USE_MOCK_LLM=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=lume@seudominio.com

# URL pública (usado em links de email)
PUBLIC_BASE_URL=http://localhost:3000